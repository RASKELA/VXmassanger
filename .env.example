# VX listens only on loopback. Publish it through your Tor onion service; do not expose this port publicly.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# The ordinary relay messenger is used when WebRTC is unavailable. It authenticates with a six-digit e-mail code.
# Gmail requires an App Password, not your main account password. Keep the real value only in .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=replace_with_a_gmail_app_password
SMTP_FROM="VX security code <you@example.com>"

# Do not expose OTPs in browser responses outside a private development machine.
DEV_SHOW_OTP=false

# P2P mode is selected automatically in browsers where WebRTC can be created.
# Use a TURN service you control for peers outside the same network.
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"vx","credential":"secret"}]

# Kept for the relay UI: true disables its optional WebRTC call controls.
TOR_ONLY=true
