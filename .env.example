# Network
# VX listens only on loopback. Publish it through the Tor onion service in
# tor/torrc.example; do not change HOST to a public interface.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Strict by default: disables browser WebRTC calls because its media transport
# is not guaranteed to use Tor. Set false only after assessing that risk.
TOR_ONLY=true

# E-mail delivery. Use the correct address krutoykrap@gmail.com — the address in
# the brief contained a likely gmaol.com typo. For Gmail, create an App Password
# (requires 2-Step Verification); do not use your regular mailbox password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=krutoykrap@gmail.com
SMTP_PASS=replace_with_a_gmail_app_password
SMTP_FROM="VX security code <krutoykrap@gmail.com>"

# In development only: returns an OTP in the browser response when SMTP is not
# configured. Never enable this on an internet-facing deployment.
DEV_SHOW_OTP=true

# Optional public WebRTC ICE configuration. Use a TURN service you control for
# production. It is deliberately blank by default to avoid silently leaking
# call traffic to a third party.
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"vx","credential":"secret"}]
